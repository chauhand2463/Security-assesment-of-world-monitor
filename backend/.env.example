# Backend configuration template.
# Copy this file to `.env` and adjust values for your environment.
# Configuration names only - never commit real credentials/keys/tokens/private URLs.

# SQLAlchemy database URL. SQLite is the default for local development.
DATABASE_URL=sqlite:///./cyberagent.db

# Runs scans in simulation mode. Code default is "false" (real execution):
# the scan pipeline runs real, authorized probes unless this is set to "true".
# Set "true" only for an explicitly sandboxed environment -- it must NEVER be
# the silent default for a security platform. When omitted, real execution runs.
SIMULATION_MODE=false

# Comma-separated list of allowed CORS origins (browser origins of the
# frontend). Only origins required by the current frontend should be listed.
# allow_credentials=True is enabled for the token-based auth flow.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175

# Session lifetime for opaque bearer tokens (hours). The server only stores a
# SHA-256 digest of each token and can revoke it via POST /auth/logout.
SESSION_TTL_HOURS=12

# Optional extra scanner binary directories (PATH-separated, e.g. "D:\PentestTools\bin").
# These are merged into the backend process PATH at startup, so tools installed
# to a non-system location are still detected and executed by the scan pipeline.
# TOOL_PATH=D:\PentestTools\bin

# Optional bootstrap admin created on startup when ALL three are configured.
# No admin is created if ADMIN_DISABLED=true (default behavior when unset).
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=<set-a-strong-password>
# ADMIN_DISABLED=false

# Reserved for a future Celery broker integration. Not currently used.
REDIS_URL=redis://localhost:6379/0

# World Monitor deployment (Phase 8). All values optional; empty = not_configured.
# Never guessed or fabricated -- only reachable authorized deployments are probed.
# WORLD_MONITOR_BASE_URL=https://wm.example.internal
# WORLD_MONITOR_API_BASE_URL=https://wm.example.internal/api/v1
# WORLD_MONITOR_OPENAPI_URL=https://wm.example.internal/openapi.json